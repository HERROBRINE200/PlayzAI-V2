# Optional build-time default. Leave blank to ask for a backend URL at runtime.
# For local development through the Vite proxy, use:
# VITE_API_BASE_URL=/playzai-backend
VITE_API_BASE_URL=

# Local-only Vite proxy target. It is not bundled into production builds.
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000
