# PlayzAI backend development configuration.
# Never commit real values. Keep AI_API_KEY only on the backend host.
PLAYZAI_ENV=development
PLAYZAI_DB=playzai.db

# OpenAI-compatible provider configuration. Leave blank until configured.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_MAX_TOKENS=800
AI_SYSTEM_PROMPT=You are PlayzAI, a helpful and safe assistant.

# Use long random values outside source control.
AUTH_SECRET=
PLAYZAI_ENROLLMENT_SECRET=
PLAYZAI_MASTER_KEY=
SESSION_TTL_SECONDS=3600

# Official WhatsApp Cloud API; leave blank until the Business account is configured.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_SECRET=

# Process-local development protections.
RATE_LIMIT_PER_MINUTE=30
AUTH_RATE_LIMIT_PER_MINUTE=12
AUTH_FAILURE_LIMIT=5
AUTH_BLOCK_SECONDS=900
